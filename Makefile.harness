.PHONY: smoke test lint typecheck check ci scan grade audit

HARNESSCLI_BIN := ./harness/target/release/harnesscli

$(HARNESSCLI_BIN):
	@cargo build --release --manifest-path harness/Cargo.toml

smoke: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) smoke

test: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) test

lint: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) lint

typecheck: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) typecheck

check: lint typecheck

audit: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) audit .

ci: smoke check test audit

scan: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) cleanup scan

grade: $(HARNESSCLI_BIN)
	@$(HARNESSCLI_BIN) cleanup grade
